<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Breadcrumbs -->
    <template
        id="portal_breadcrumbs_stock_request"
        name="Portal breadcrumbs: stock request orders"
        inherit_id="portal.portal_breadcrumbs"
        priority="40"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'stock_request_order' and not order"
                class="breadcrumb-item active"
            >
                Stock Requests
            </li>
            <li
                t-if="order or page_name == 'stock_request_order_new'"
                class="breadcrumb-item"
            >
                <a t-attf-href="/my/stock-request-orders">Stock Requests</a>
            </li>
            <li t-if="order" class="breadcrumb-item active">
                <t t-out="order.name" />
            </li>
            <li
                t-if="page_name == 'stock_request_order_new'"
                class="breadcrumb-item active"
            >
                New
            </li>
        </xpath>
    </template>

    <!-- /my home card: own row next to the client category -->
    <template
        id="portal_my_home_stock_request"
        name="Portal My Home: stock request orders"
        inherit_id="portal.portal_my_home"
        priority="40"
    >
        <div id="portal_client_category" position="after">
            <div
                class="o_portal_category row g-2 mt-3"
                id="portal_stock_request_category"
            >
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/stock_request_portal/static/src/img/stock-request.svg'" />
                    <t t-set="config_card" t-value="True" />
                    <t t-set="title">Stock Requests</t>
                    <t t-set="url" t-value="'/my/stock-request-orders'" />
                    <t t-set="text">Create and follow your stock requests</t>
                    <t t-set="placeholder_count" t-value="'stock_request_order_count'" />
                </t>
            </div>
        </div>
    </template>

    <!-- Orders list -->
    <template id="portal_my_stock_request_orders" name="My Stock Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Stock Requests</t>
            </t>

            <div class="d-flex justify-content-end mb-3">
                <a
                    href="/my/stock-request-orders/new"
                    class="btn btn-primary"
                >
                    <i class="fa fa-plus" /> New Stock Request
                </a>
            </div>

            <div
                t-if="not orders"
                class="alert alert-warning"
                role="alert"
            >
                There are currently no stock requests for your account.
            </div>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th class="text-end">Created on</th>
                        <th class="text-end">Expected Date</th>
                        <th class="text-end">Lines</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <t t-foreach="orders" t-as="order">
                    <tr>
                        <td>
                            <a t-attf-href="/my/stock-request-orders/{{ order.id }}">
                                <t t-out="order.name" />
                            </a>
                        </td>
                        <td class="text-end">
                            <span t-field="order.create_date" t-options="{'widget': 'datetime'}" />
                        </td>
                        <td class="text-end">
                            <span t-field="order.expected_date" t-options="{'widget': 'datetime'}" />
                        </td>
                        <td class="text-end">
                            <t t-out="order.stock_request_count" />
                        </td>
                        <td class="text-center">
                            <span
                                t-if="order.state == 'draft'"
                                class="badge rounded-pill text-bg-secondary"
                            >To Review</span>
                            <span
                                t-elif="order.state == 'open'"
                                class="badge rounded-pill text-bg-info"
                            >In Progress</span>
                            <span
                                t-elif="order.state == 'done'"
                                class="badge rounded-pill text-bg-success"
                            >Done</span>
                            <span
                                t-elif="order.state == 'cancel'"
                                class="badge rounded-pill text-bg-danger"
                            >Cancelled</span>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <!-- New order form with product catalog -->
    <template id="portal_stock_request_order_new" name="New Stock Request">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-12 col-lg-8">
                    <h3 class="mb-4">New Stock Request</h3>

                    <div t-if="error" class="alert alert-danger" role="alert">
                        <t t-out="error" />
                    </div>

                    <t t-if="not location">
                        <div class="alert alert-warning" role="alert">
                            Your contact has no stock request destination
                            location configured yet. Please contact us
                            before submitting a request.
                        </div>
                    </t>

                    <form
                        method="POST"
                        action="/my/stock-request-orders/new"
                        id="stock_request_order_form"
                    >
                        <input
                            type="hidden"
                            name="csrf_token"
                            t-att-value="request.csrf_token()"
                        />

                        <div class="mb-3">
                            <label class="form-label" for="expected_date">
                                Expected Date
                            </label>
                            <input
                                type="datetime-local"
                                class="form-control"
                                id="expected_date"
                                name="expected_date"
                                required="required"
                                t-att-value="default_expected_date"
                            />
                        </div>

                        <div
                            class="o_sr_category_bar bg-body-tertiary rounded-3 p-2 mb-3 d-flex flex-wrap gap-2 align-items-center"
                            id="o_sr_categories"
                            t-if="products"
                        >
                            <button
                                type="button"
                                class="btn btn-sm rounded-pill o_sr_category_chip active"
                                data-category-id=""
                            >
                                All
                                <span
                                    class="badge rounded-pill o_sr_chip_count"
                                    t-out="len(products)"
                                />
                            </button>
                            <t t-foreach="categories" t-as="cat_info">
                                <t t-set="cat" t-value="cat_info['category']" />
                                <t t-set="cat_count" t-value="cat_info['count']" />
                                <button
                                    type="button"
                                    class="btn btn-sm rounded-pill o_sr_category_chip"
                                    t-att-data-category-id="cat.id"
                                >
                                    <t t-out="cat.display_name" />
                                    <span
                                        class="badge rounded-pill o_sr_chip_count"
                                        t-out="cat_count"
                                    />
                                </button>
                            </t>
                        </div>

                        <div class="row mb-2">
                            <t t-foreach="products" t-as="product">
                                <div class="col-6 col-md-4 col-lg-3 mb-3 o_sr_product_col">
                                    <div
                                        class="card h-100 o_sr_product_card"
                                        t-att-data-category-id="product.categ_id.id"
                                        t-att-data-product-id="product.id"
                                        t-att-data-product-name="product.display_name"
                                    >
                                        <div class="card-body d-flex flex-column">
                                            <h6 class="card-title mb-1 fw-bold">
                                                <t t-out="product.display_name" />
                                            </h6>
                                            <div t-if="product.default_code" class="small text-muted mb-2">
                                                <t t-out="product.default_code" />
                                            </div>
                                            <div class="mt-auto pt-2 d-flex gap-2">
                                                <div
                                                    class="input-group input-group-sm o_sr_qty_stepper"
                                                >
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-secondary o_sr_qty_minus"
                                                        aria-label="Decrease quantity"
                                                    >
                                                        <i class="fa fa-minus" />
                                                    </button>
                                                    <input
                                                        type="number"
                                                        class="form-control text-center o_sr_card_qty"
                                                        min="1"
                                                        step="1"
                                                        value="1"
                                                        aria-label="Quantity"
                                                    />
                                                    <button
                                                        type="button"
                                                        class="btn btn-outline-secondary o_sr_qty_plus"
                                                        aria-label="Increase quantity"
                                                    >
                                                        <i class="fa fa-plus" />
                                                    </button>
                                                </div>
                                                <button
                                                    type="button"
                                                    class="btn btn-sm btn-outline-primary flex-grow-1 o_sr_add_product"
                                                >
                                                    <i class="fa fa-plus me-1" /> Add
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <div t-if="not products" class="col-12">
                                <div class="alert alert-info" role="alert">
                                    No products found.
                                </div>
                            </div>
                        </div>

                        <div class="card mt-4 o_sr_lines_card">
                            <div class="card-header bg-transparent d-flex align-items-center gap-2">
                                <h5 class="card-title mb-0 fs-6">
                                    Order lines
                                    <span
                                        class="badge rounded-pill text-bg-primary"
                                        id="o_sr_line_count"
                                    >0</span>
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle mb-0">
                                        <thead>
                                            <tr>
                                                <th>Product</th>
                                                <th class="text-end">Quantity</th>
                                                <th />
                                            </tr>
                                        </thead>
                                        <tbody id="stock_request_lines">
                                            <tr id="o_sr_no_lines" class="text-muted">
                                                <td colspan="3">
                                                    Add products to your
                                                    request from the catalog
                                                    above.
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <button
                            type="submit"
                            class="btn btn-primary mt-3"
                            t-att-disabled="not location and 'disabled'"
                        >
                            Submit Request
                        </button>
                    </form>

                    <template id="o_sr_line_template">
                        <tr class="o_sr_line">
                            <td>
                                <span class="o_sr_line_name" />
                                <input
                                    type="hidden"
                                    name="product_id"
                                    class="o_sr_product"
                                />
                            </td>
                            <td>
                                <input
                                    type="number"
                                    name="product_uom_qty"
                                    class="form-control o_sr_qty"
                                    min="1"
                                    step="1"
                                    value="1"
                                    required="required"
                                />
                            </td>
                            <td class="text-end">
                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-danger o_sr_remove"
                                    title="Remove line"
                                >
                                    <i class="fa fa-trash-o" />
                                </button>
                            </td>
                        </tr>
                    </template>
                </div>
                <div class="col-12 col-lg-4" t-if="location or warehouse">
                    <h5 class="mb-1">Request details</h5>
                    <hr class="mt-1 mb-2" />
                    <table class="table table-sm table-borderless">
                        <tbody>
                            <tr t-if="location">
                                <th class="ps-0">Destination Location:</th>
                                <td><t t-out="location.display_name" /></td>
                            </tr>
                            <tr t-if="warehouse">
                                <th class="ps-0">Source Warehouse:</th>
                                <td><t t-out="warehouse.name" /></td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-muted small">
                        Your request will be reviewed by our team. Available
                        stock is transferred directly and missing quantities
                        are purchased from our suppliers.
                    </p>
                </div>
            </div>
        </t>
    </template>

    <!-- Order detail -->
    <template id="portal_stock_request_order_page" name="Stock Request">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-12">
                    <h3 class="mb-4">
                        Stock Request <em t-out="order.name" />
                    </h3>

                    <div
                        t-if="message == 'submitted'"
                        class="alert alert-success"
                        role="status"
                    >
                        Your request has been submitted and is pending review
                        by our team.
                    </div>

                    <div class="row mb-4">
                        <div class="col-12 col-lg-6">
                            <h5 class="mb-1">Information</h5>
                            <hr class="mt-1 mb-2" />
                            <table class="table table-sm table-borderless">
                                <tbody>
                                    <tr>
                                        <th class="ps-0">Created on:</th>
                                        <td>
                                            <span
                                                t-field="order.create_date"
                                                t-options="{'widget': 'datetime'}"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Requested by:</th>
                                        <td><t t-out="order.requested_by.name" /></td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Expected Date:</th>
                                        <td>
                                            <span
                                                t-field="order.expected_date"
                                                t-options="{'widget': 'datetime'}"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Destination Location:</th>
                                        <td>
                                            <t t-out="order.location_id.display_name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Warehouse:</th>
                                        <td><t t-out="order.warehouse_id.name" /></td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Status:</th>
                                        <td>
                                            <span
                                                t-if="order.state == 'draft'"
                                                class="badge rounded-pill text-bg-secondary"
                                            >To Review</span>
                                            <span
                                                t-elif="order.state == 'open'"
                                                class="badge rounded-pill text-bg-info"
                                            >In Progress</span>
                                            <span
                                                t-elif="order.state == 'done'"
                                                class="badge rounded-pill text-bg-success"
                                            >Done</span>
                                            <span
                                                t-elif="order.state == 'cancel'"
                                                class="badge rounded-pill text-bg-danger"
                                            >Cancelled</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <h5 class="mb-1">Products</h5>
                    <hr class="mt-1 mb-2" />
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Requested Quantity</th>
                                    <th class="text-end">Unit</th>
                                    <th class="text-end">From Stock</th>
                                    <th class="text-end">To Purchase</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="order.stock_request_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-out="line.product_id.display_name" />
                                        </td>
                                        <td class="text-end">
                                            <t t-out="line.product_uom_qty" />
                                        </td>
                                        <td class="text-end">
                                            <t t-out="line.product_uom_id.name" />
                                        </td>
                                        <td class="text-end">
                                            <t
                                                t-if="order.state != 'draft'"
                                                t-out="line.qty_from_stock"
                                            />
                                            <t t-else="">—</t>
                                        </td>
                                        <td class="text-end">
                                            <t t-out="line.qty_to_purchase" />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
