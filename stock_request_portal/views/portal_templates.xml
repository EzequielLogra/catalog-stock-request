<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Breadcrumbs -->
    <template
        id="portal_breadcrumbs_stock_request"
        name="Portal breadcrumbs: stock request orders"
        inherit_id="portal.portal_breadcrumbs"
        priority="40"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'stock_request_order' and not order"
                class="breadcrumb-item active"
            >
                Stock Requests
            </li>
            <li
                t-if="order or page_name == 'stock_request_order_new'"
                class="breadcrumb-item"
            >
                <a t-attf-href="/my/stock-request-orders">Stock Requests</a>
            </li>
            <li t-if="order" class="breadcrumb-item active">
                <t t-out="order.name" />
            </li>
            <li
                t-if="page_name == 'stock_request_order_new'"
                class="breadcrumb-item active"
            >
                New
            </li>
        </xpath>
    </template>

    <!-- /my home card: own row next to the client category -->
    <template
        id="portal_my_home_stock_request"
        name="Portal My Home: stock request orders"
        inherit_id="portal.portal_my_home"
        priority="40"
    >
        <div id="portal_client_category" position="after">
            <div
                class="o_portal_category row g-2 mt-3"
                id="portal_stock_request_category"
            >
                <t t-call="portal.portal_docs_entry">
                    <t t-set="icon" t-value="'/stock_request_portal/static/src/img/stock-request.svg'" />
                    <t t-set="config_card" t-value="True" />
                    <t t-set="title">Stock Requests</t>
                    <t t-set="url" t-value="'/my/stock-request-orders'" />
                    <t t-set="text">Create and follow your stock requests</t>
                    <t t-set="placeholder_count" t-value="'stock_request_order_count'" />
                </t>
            </div>
        </div>
    </template>

    <!-- Orders list -->
    <template id="portal_my_stock_request_orders" name="My Stock Requests">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Stock Requests</t>
            </t>

            <div class="d-flex justify-content-end mb-3">
                <a
                    href="/my/stock-request-orders/new"
                    class="btn btn-primary"
                >
                    <i class="fa fa-plus" /> New Stock Request
                </a>
            </div>

            <div
                t-if="not orders"
                class="alert alert-warning"
                role="alert"
            >
                There are currently no stock requests for your account.
            </div>
            <t t-if="orders" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th class="text-end">Created on</th>
                        <th class="text-end">Expected Date</th>
                        <th class="text-end">Lines</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <t t-foreach="orders" t-as="order">
                    <tr>
                        <td>
                            <a t-attf-href="/my/stock-request-orders/{{ order.id }}">
                                <t t-out="order.name" />
                            </a>
                        </td>
                        <td class="text-end">
                            <span t-field="order.create_date" t-options="{'widget': 'datetime'}" />
                        </td>
                        <td class="text-end">
                            <span t-field="order.expected_date" t-options="{'widget': 'datetime'}" />
                        </td>
                        <td class="text-end">
                            <t t-out="order.stock_request_count" />
                        </td>
                        <td class="text-center">
                            <span
                                t-if="order.state == 'draft'"
                                class="badge rounded-pill text-bg-secondary"
                            >To Review</span>
                            <span
                                t-elif="order.state == 'open'"
                                class="badge rounded-pill text-bg-info"
                            >In Progress</span>
                            <span
                                t-elif="order.state == 'done'"
                                class="badge rounded-pill text-bg-success"
                            >Done</span>
                            <span
                                t-elif="order.state == 'cancel'"
                                class="badge rounded-pill text-bg-danger"
                            >Cancelled</span>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <!-- New order form with product catalog -->
    <template id="portal_stock_request_order_new" name="New Stock Request">
        <t t-call="portal.portal_layout">
            <div class="o_sr_portal" t-att-style="sr_style">
                <h3 class="mb-4 o_sr_title">New Stock Request</h3>

                <div t-if="error" class="alert alert-danger" role="alert">
                    <t t-out="error" />
                </div>

                <t t-if="not locations">
                    <div class="alert alert-warning" role="alert">
                        Your contact has no stock request destination
                        locations configured yet. Please contact us
                        before submitting a request.
                    </div>
                </t>

                <form
                    method="POST"
                    action="/my/stock-request-orders/new"
                    id="stock_request_order_form"
                >
                    <input
                        type="hidden"
                        name="csrf_token"
                        t-att-value="request.csrf_token()"
                    />
                    <div class="row">
                        <div class="col-12 col-lg-8">
                            <div class="o_sr_panel mb-3">
                                <div class="row g-3">
                                    <div class="col-12 col-md">
                                        <label class="o_sr_label" for="expected_date">
                                            Expected Date
                                        </label>
                                        <input
                                            type="datetime-local"
                                            class="form-control"
                                            id="expected_date"
                                            name="expected_date"
                                            required="required"
                                            t-att-value="default_expected_date"
                                        />
                                    </div>
                                    <div class="col-12 col-md" t-if="locations">
                                        <label class="o_sr_label" for="location_id">
                                            Destination Location
                                        </label>
                                        <select
                                            class="form-select"
                                            id="location_id"
                                            name="location_id"
                                            required="required"
                                        >
                                            <t t-foreach="locations" t-as="loc">
                                                <option t-att-value="loc.id">
                                                    <t t-out="loc.display_name" />
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="o_sr_panel mb-3" t-if="products">
                                <div class="o_sr_search mb-3">
                                    <i class="fa fa-search" />
                                    <input
                                        type="search"
                                        class="form-control"
                                        id="o_sr_search"
                                        placeholder="Search by reference or name..."
                                        aria-label="Search products"
                                        autocomplete="off"
                                    />
                                </div>
                                <div
                                    class="o_sr_category_bar"
                                    id="o_sr_categories"
                                >
                                    <button
                                        type="button"
                                        class="o_sr_category_chip active"
                                        data-category-id=""
                                    >
                                        <span>All</span>
                                        <span
                                            class="o_sr_chip_count"
                                            t-out="len(products)"
                                        />
                                    </button>
                                    <t t-foreach="categories" t-as="cat_info">
                                        <t t-set="cat" t-value="cat_info['category']" />
                                        <t t-set="cat_count" t-value="cat_info['count']" />
                                        <button
                                            type="button"
                                            class="o_sr_category_chip"
                                            t-att-data-category-id="cat.id"
                                        >
                                            <span t-out="cat.display_name" />
                                            <span
                                                class="o_sr_chip_count"
                                                t-out="cat_count"
                                            />
                                        </button>
                                    </t>
                                </div>
                            </div>

                            <div
                                class="row g-3 mb-3"
                                id="o_sr_product_grid"
                                t-att-data-per-page="products_per_page"
                            >
                                <t t-foreach="products" t-as="product">
                                    <!-- Only the first page is visible until the
                                         client-side pager takes over. -->
                                    <div
                                        t-attf-class="col-6 col-md-4 col-xl-3 o_sr_product_col #{'d-none' if product_index >= products_per_page else ''}"
                                    >
                                        <div
                                            class="o_sr_product_card h-100 d-flex flex-column"
                                            t-att-data-category-id="product.categ_id.id"
                                            t-att-data-product-id="product.id"
                                            t-att-data-product-name="product.name"
                                            t-att-data-product-ref="product.default_code or ''"
                                        >
                                            <h6 class="o_sr_card_title mb-1">
                                                <t t-out="product.name" />
                                            </h6>
                                            <div
                                                t-if="product.default_code"
                                                class="o_sr_card_ref"
                                            >
                                                Ref: <t t-out="product.default_code" />
                                            </div>
                                            <div class="o_sr_card_actions mt-auto d-flex gap-2">
                                                <div class="o_sr_qty_stepper d-flex">
                                                    <button
                                                        type="button"
                                                        class="o_sr_qty_minus"
                                                        aria-label="Decrease quantity"
                                                    >
                                                        <i class="fa fa-minus" />
                                                    </button>
                                                    <input
                                                        type="number"
                                                        class="o_sr_card_qty"
                                                        min="1"
                                                        step="1"
                                                        value="1"
                                                        aria-label="Quantity"
                                                    />
                                                    <button
                                                        type="button"
                                                        class="o_sr_qty_plus"
                                                        aria-label="Increase quantity"
                                                    >
                                                        <i class="fa fa-plus" />
                                                    </button>
                                                </div>
                                                <button
                                                    type="button"
                                                    class="flex-grow-1 o_sr_add_product"
                                                >
                                                    <i class="fa fa-plus me-1" /> Add
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                <div class="col-12 d-none" id="o_sr_no_results">
                                    <div class="alert alert-info mb-0" role="alert">
                                        No products match your search.
                                    </div>
                                </div>
                                <div t-if="not products" class="col-12">
                                    <div class="alert alert-info" role="alert">
                                        No products found.
                                    </div>
                                </div>
                            </div>

                            <nav
                                class="o_sr_pager d-none justify-content-center align-items-center gap-3 mb-4"
                                id="o_sr_pager"
                                aria-label="Catalog pages"
                            >
                                <button
                                    type="button"
                                    class="o_sr_page_btn o_sr_page_prev"
                                    aria-label="Previous page"
                                >
                                    <i class="fa fa-chevron-left" />
                                </button>
                                <span class="o_sr_page_status">
                                    <span id="o_sr_page_current">1</span>
                                    /
                                    <span id="o_sr_page_total">1</span>
                                </span>
                                <button
                                    type="button"
                                    class="o_sr_page_btn o_sr_page_next"
                                    aria-label="Next page"
                                >
                                    <i class="fa fa-chevron-right" />
                                </button>
                            </nav>
                        </div>

                        <div class="col-12 col-lg-4">
                            <div class="o_sr_sidebar">
                                <div class="o_sr_panel mb-3" t-if="warehouse">
                                    <h5 class="o_sr_panel_title">Request details</h5>
                                    <table class="table table-sm table-borderless mb-2">
                                        <tbody>
                                            <tr t-if="warehouse">
                                                <th class="ps-0">Source Warehouse:</th>
                                                <td><t t-out="warehouse.name" /></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <p class="text-muted small mb-0">
                                        Your request will be reviewed by our team. Available
                                        stock is transferred directly and missing quantities
                                        are purchased from our suppliers.
                                    </p>
                                </div>

                                <div class="o_sr_panel o_sr_lines_card">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <h5 class="o_sr_panel_title mb-0">Order lines</h5>
                                        <span
                                            class="o_sr_line_count"
                                            id="o_sr_line_count"
                                        >0</span>
                                    </div>
                                    <div class="o_sr_lines" id="stock_request_lines">
                                        <div id="o_sr_no_lines" class="text-muted small py-3">
                                            Add products to your request from
                                            the catalog.
                                        </div>
                                    </div>
                                    <div
                                        id="o_sr_no_lines_error"
                                        class="alert alert-danger small py-2 d-none"
                                        role="alert"
                                    >
                                        Add at least one product line to
                                        submit a request.
                                    </div>
                                    <div class="o_sr_total d-flex justify-content-between align-items-center">
                                        <span>Total units:</span>
                                        <span
                                            class="o_sr_total_qty"
                                            id="o_sr_total_qty"
                                        >0</span>
                                    </div>
                                    <button
                                        type="submit"
                                        class="o_sr_submit w-100"
                                        t-att-disabled="not locations and 'disabled'"
                                    >
                                        <i class="fa fa-paper-plane me-2" />Submit Request
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <template id="o_sr_line_template">
                    <div class="o_sr_line d-flex align-items-center justify-content-between gap-2">
                        <div class="o_sr_line_info">
                            <div class="o_sr_line_ref" />
                            <div class="o_sr_line_name" />
                            <input
                                type="hidden"
                                name="product_id"
                                class="o_sr_product"
                            />
                        </div>
                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            <input
                                type="number"
                                name="product_uom_qty"
                                class="o_sr_qty"
                                min="1"
                                step="1"
                                value="1"
                                required="required"
                                aria-label="Quantity"
                            />
                            <button
                                type="button"
                                class="o_sr_remove"
                                title="Remove line"
                            >
                                <i class="fa fa-times" />
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </t>
    </template>

    <!-- Order detail -->
    <template id="portal_stock_request_order_page" name="Stock Request">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-12">
                    <h3 class="mb-4">
                        Stock Request <em t-out="order.name" />
                    </h3>

                    <div
                        t-if="message == 'submitted'"
                        class="alert alert-success"
                        role="status"
                    >
                        Your request has been submitted and is pending review
                        by our team.
                    </div>

                    <div class="row mb-4">
                        <div class="col-12 col-lg-6">
                            <h5 class="mb-1">Information</h5>
                            <hr class="mt-1 mb-2" />
                            <table class="table table-sm table-borderless">
                                <tbody>
                                    <tr>
                                        <th class="ps-0">Created on:</th>
                                        <td>
                                            <span
                                                t-field="order.create_date"
                                                t-options="{'widget': 'datetime'}"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Requested by:</th>
                                        <td><t t-out="order.requested_by.name" /></td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Expected Date:</th>
                                        <td>
                                            <span
                                                t-field="order.expected_date"
                                                t-options="{'widget': 'datetime'}"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Destination Location:</th>
                                        <td>
                                            <t t-out="order.location_id.display_name" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Warehouse:</th>
                                        <td><t t-out="order.warehouse_id.name" /></td>
                                    </tr>
                                    <tr>
                                        <th class="ps-0">Status:</th>
                                        <td>
                                            <span
                                                t-if="order.state == 'draft'"
                                                class="badge rounded-pill text-bg-secondary"
                                            >To Review</span>
                                            <span
                                                t-elif="order.state == 'open'"
                                                class="badge rounded-pill text-bg-info"
                                            >In Progress</span>
                                            <span
                                                t-elif="order.state == 'done'"
                                                class="badge rounded-pill text-bg-success"
                                            >Done</span>
                                            <span
                                                t-elif="order.state == 'cancel'"
                                                class="badge rounded-pill text-bg-danger"
                                            >Cancelled</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <h5 class="mb-1">Products</h5>
                    <hr class="mt-1 mb-2" />
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-end">Requested Quantity</th>
                                    <th class="text-end">Unit</th>
                                    <!-- Supply split is internal information -->
                                    <t t-if="show_supply_split">
                                        <th class="text-end">From Stock</th>
                                        <th class="text-end">To Purchase</th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="order.stock_request_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-out="line.product_id.display_name" />
                                        </td>
                                        <td class="text-end">
                                            <t t-out="line.product_uom_qty" />
                                        </td>
                                        <td class="text-end">
                                            <t t-out="line.product_uom_id.name" />
                                        </td>
                                        <t t-if="show_supply_split">
                                            <td class="text-end">
                                                <t
                                                    t-if="order.state != 'draft'"
                                                    t-out="line.qty_from_stock"
                                                />
                                                <t t-else="">—</t>
                                            </td>
                                            <td class="text-end">
                                                <t t-out="line.qty_to_purchase" />
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
