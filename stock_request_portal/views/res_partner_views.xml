<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_stock_request_portal" model="ir.ui.view">
        <field name="name">res.partner.form.stock.request.portal</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="stock_request_location_id" />
                <field
                    name="stock_request_supervisor_ids"
                    widget="many2many_tags"
                    invisible="not stock_request_location_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
