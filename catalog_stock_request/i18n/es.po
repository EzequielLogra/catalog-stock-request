#. module: catalog_stock_request
#: code:addons/catalog_stock_request/models/stock_request.py:0
msgid ""
"No internal supply route found for product %(product)s to location "
"%(location)s."
msgstr ""
"No se encontró una ruta interna de abastecimiento para el producto "
"%(product)s hacia la ubicación %(location)s."

#. module: catalog_stock_request
#: code:addons/catalog_stock_request/models/stock_request.py:0
msgid ""
"No supplier found for product %(product)s, but %(qty)s %(uom)s still need "
"to be purchased."
msgstr ""
"No se encontró proveedor para el producto %(product)s, pero aún se deben "
"comprar %(qty)s %(uom)s."

#. module: catalog_stock_request
#: code:addons/catalog_stock_request/models/stock_request.py:0
msgid "Route %(route)s has no buy rule for warehouse %(warehouse)s."
msgstr ""
"La ruta %(route)s no tiene una regla de compra para el almacén "
"%(warehouse)s."

#. module: catalog_stock_request
#: code:addons/catalog_stock_request/models/stock_request.py:0
msgid ""
"You cannot cancel this request because the following purchase orders are "
"already confirmed: %(orders)s. Cancel them first."
msgstr ""
"No puede cancelar esta solicitud porque las siguientes órdenes de compra "
"ya están confirmadas: %(orders)s. Cáncelas primero."

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_res_partner__supplier_rank
msgid "Supplier Ranking"
msgstr "Ranking de proveedor"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_res_partner__supplier_rank
msgid ""
"Manual supplier ranking used to suggest purchase suppliers for stock "
"requests. Lower values have priority (0 = no priority)."
msgstr ""
"Ranking manual de proveedores utilizado para sugerir proveedores de compra "
"para solicitudes de abastecimiento. Los valores más bajos tienen prioridad "
"(0 = sin prioridad)."

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request__free_qty
msgid "Free To Use"
msgstr "Libre para usar"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_stock_request__free_qty
msgid "Free quantity in the warehouse stock location."
msgstr "Cantidad libre en la ubicación de stock del almacén."

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request__qty_reserved
msgid "Reserved Quantity"
msgstr "Cantidad reservada"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_stock_request__qty_reserved
msgid "Quantity reserved by the internal transfer of this request."
msgstr "Cantidad reservada por la transferencia interna de esta solicitud."

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request__qty_to_purchase
msgid "Quantity To Purchase"
msgstr "Cantidad a comprar"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_stock_request__qty_to_purchase
msgid ""
"Missing quantity that will be purchased (estimated in draft, real once "
"confirmed)."
msgstr ""
"Cantidad faltante que se comprará (estimada en borrador, real una vez "
"confirmada)."

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request__qty_from_stock
msgid "Quantity From Stock"
msgstr "Cantidad desde stock"

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request__qty_purchased
msgid "Purchased Quantity"
msgstr "Cantidad comprada"

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request__suggested_supplier_id
msgid "Suggested Supplier"
msgstr "Proveedor sugerido"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_stock_request__suggested_supplier_id
msgid ""
"Supplier suggested according to the manual partner ranking and the vendor "
"pricelists of the product."
msgstr ""
"Proveedor sugerido según el ranking manual de contactos y las tarifas de "
"proveedor del producto."

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request_order__split_purchase
msgid "Split Stock / Purchase"
msgstr "Dividir stock / compra"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_stock_request_order__split_purchase
msgid ""
"If enabled, confirming this order reserves the free stock available in the "
"warehouse and creates RFQs only for the missing quantities."
msgstr ""
"Si está activado, al confirmar esta orden se reserva el stock libre "
"disponible en el almacén y se crean RFQ solo para las cantidades faltantes."

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_stock_request_order__purchase_route_id
msgid "Purchase Route"
msgstr "Ruta de compra"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_stock_request_order__purchase_route_id
msgid ""
"Route used to purchase the missing quantity of the request lines when "
"confirming this order."
msgstr ""
"Ruta utilizada para comprar la cantidad faltante de las líneas de la "
"solicitud al confirmar esta orden."

#. module: catalog_stock_request
#: model:ir.ui.view,arch_db:catalog_stock_request.stock_request_order_form_catalog
msgid "Add a line"
msgstr "Agregar una línea"

#. module: catalog_stock_request
#: model:ir.ui.view,arch_db:catalog_stock_request.stock_request_order_form_catalog
msgid "Catalog"
msgstr "Catálogo"

#. module: catalog_stock_request
#: model:ir.ui.view,arch_db:catalog_stock_request.stock_request_order_tree_catalog
msgid "RFQs"
msgstr "RFQ"

#. module: catalog_stock_request
#: model:ir.model.fields,field_description:catalog_stock_request.field_purchase_order__obra_location_id
#: model:ir.ui.view,arch_db:catalog_stock_request.view_purchase_order_filter_obra
#: model:ir.ui.view,arch_db:catalog_stock_request.purchase_order_view_search_obra
msgid "Obra"
msgstr "Obra"

#. module: catalog_stock_request
#: model:ir.model.fields,help:catalog_stock_request.field_purchase_order__obra_location_id
msgid ""
"Destination location of the stock request order that generated this "
"purchase. Empty for manual purchases."
msgstr ""
"Ubicación destino de la orden de solicitud que generó esta compra. Vacía "
"para compras manuales."
