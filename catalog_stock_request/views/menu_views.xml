<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="supply_request_order_action" model="ir.actions.act_window">
        <field name="name">Solicitudes de abastecimiento</field>
        <field name="res_model">stock.request.order</field>
        <field name="type">ir.actions.act_window</field>
        <field name="path">catalog-supply-requests</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"default_split_purchase": True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una solicitud de abastecimiento
            </p>
            <p>
                Al confirmar, el stock libre del almacén se reserva en una
                transferencia interna y el faltante genera RFQs agrupadas por
                proveedor según el ranking manual.
            </p>
        </field>
    </record>

    <menuitem
        id="supply_request_order_menu"
        name="Solicitudes de abastecimiento"
        parent="stock_request.menu_stock_request_operations"
        action="supply_request_order_action"
        sequence="5"
    />
</odoo>
