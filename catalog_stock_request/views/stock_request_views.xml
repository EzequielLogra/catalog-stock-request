<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_stock_request_tree_catalog" model="ir.ui.view">
        <field name="name">stock.request.list.catalog</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="stock_request.view_stock_request_tree" />
        <field name="arch" type="xml">
            <field name="product_uom_qty" position="after">
                <field name="free_qty" optional="show" />
                <field name="qty_reserved" optional="show" />
                <field name="qty_to_purchase" optional="show" />
                <field name="suggested_supplier_id" optional="show" />
            </field>
        </field>
    </record>

    <record id="view_stock_request_form_catalog" model="ir.ui.view">
        <field name="name">stock.request.form.catalog</field>
        <field name="model">stock.request</field>
        <field name="inherit_id" ref="stock_request.view_stock_request_form" />
        <field name="arch" type="xml">
            <field name="qty_cancelled" position="after">
                <field name="free_qty" />
                <field name="qty_reserved" />
                <field name="qty_to_purchase" />
                <field name="suggested_supplier_id" />
                <field name="qty_from_stock" invisible="state == 'draft'" />
                <field name="qty_purchased" invisible="state == 'draft'" />
            </field>
        </field>
    </record>
</odoo>
